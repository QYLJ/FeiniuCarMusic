<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:background="@drawable/bg_list_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="12dp">

    <com.feiniu.carmusic.ui.RoundedCoverView
        android:id="@+id/track_cover"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_cover_placeholder"
        android:contentDescription="封面"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="9dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/track_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/track_duration"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.feiniu.carmusic.ui.IconButton
        android:id="@+id/track_favorite"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:background="@drawable/bg_icon_button"
        android:tag="favorite"
        android:focusable="false"
        android:gravity="center"
        android:text="收藏"
        android:textColor="@color/primary"
        android:textSize="20sp" />
</LinearLayout>
