<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="@color/scrim_start"
                android:centerColor="@color/scrim_center"
                android:endColor="@color/scrim_end" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="@color/scrim_top"
                android:centerColor="@color/scrim_clear"
                android:endColor="@color/scrim_bottom" />
        </shape>
    </item>
</layer-list>
